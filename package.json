{
  "name": "@apiuikit/ws-try-it-plugin",
  "version": "0.1.0",
  "description": "WebSocket Try it panels for APIUIKIT AsyncAPI operations",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/apiuikit/ws-try-it-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apiuikit/ws-try-it-plugin.git"
  },
  "homepage": "https://github.com/apiuikit/ws-try-it-plugin#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "asyncapi",
    "websocket",
    "plugin",
    "react"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "apiuikit": "^1.7.0 || ^2.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "apiuikit": "^2.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
